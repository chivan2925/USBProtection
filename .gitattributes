/mvnw text eol=lf
*.cmd text eol=crlf

# Unix runtime/packaging scripts must remain executable with bash on Linux.
*.sh text eol=lf
packaging/agent-deb/DEBIAN/postinst text eol=lf
packaging/agent-deb/DEBIAN/prerm text eol=lf

# Preserve Linux package/service configuration when checked out on Windows.
packaging/systemd/*.service text eol=lf
packaging/desktop/*.desktop text eol=lf
packaging/agent-deb/etc/usbshield-agent/*.yml text eol=lf
packaging/usbguard/*.conf text eol=lf
