+package com.group.usbshield.agent.notification;
+
+import com.group.usbshield.agent.config.AgentProperties;
+import com.group.usbshield.agent.session.ActiveUserInfo;
+import com.group.usbshield.agent.usbguard.UsbDeviceInfo;
+import com.group.usbshield.agent.usbguard.UsbGuardGateway;
+import org.junit.jupiter.api.Test;
+import java.util.List;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class UbuntuFinalStateNotificationTest {
+    private static final ActiveUserInfo USER = ActiveUserInfo.resolved("usbdev", 1000L, "4", "wayland", "seat0");
+    private static UsbDeviceInfo device(String state) {
+        return new UsbDeviceInfo(16, state, "0951", "1665", "serial", "DataTraveler 2.0", "hash-A",
+                List.of("08:06:50"), true, "");
+    }
+    private static AgentProperties enabled() {
+        AgentProperties props = new AgentProperties();
+        props.setNotificationEnabled(true);
+        return props;
+    }
+
+    @Test
+    void transientBlockBecomesAllowedSoNoFalsePopup() throws Exception {
+        UsbGuardGateway gateway = mock(UsbGuardGateway.class);
+        when(gateway.listDevices()).thenReturn(List.of(device("allow")));
+        AtomicInteger popups = new AtomicInteger();
+        DesktopNotificationService service = new DesktopNotificationService(enabled(), notice -> {
+            popups.incrementAndGet();
+            return ClientNotificationPublisher.Delivery.DELIVERED;
+        }, gateway, 50);
+        try {
+            service.notifyBlockedUsb(USER, device("block"));
+            Thread.sleep(250);
+            assertEquals(0, popups.get());
+            verify(gateway, atLeastOnce()).listDevices();
+        } finally {
+            service.stop();
+        }
+    }
+
+    @Test
+    void effectiveBlockedStorageStillNotifiesOnce() throws Exception {
+        UsbGuardGateway gateway = mock(UsbGuardGateway.class);
+        when(gateway.listDevices()).thenReturn(List.of(device("block")));
+        CountDownLatch shown = new CountDownLatch(1);
+        AtomicInteger popups = new AtomicInteger();
+        DesktopNotificationService service = new DesktopNotificationService(enabled(), notice -> {
+            popups.incrementAndGet();
+            shown.countDown();
+            return ClientNotificationPublisher.Delivery.DELIVERED;
+        }, gateway, 50);
+        try {
+            service.notifyBlockedUsb(USER, device("block"));
+            assertTrue(shown.await(3, TimeUnit.SECONDS));
+            assertEquals(1, popups.get());
+        } finally {
+            service.stop();
+        }
+    }
+
+    @Test
+    void finalAllowCancelsPendingBeforePublisherRuns() throws Exception {
+        UsbGuardGateway gateway = mock(UsbGuardGateway.class);
+        when(gateway.listDevices()).thenReturn(List.of(device("block")));
+        AtomicInteger popups = new AtomicInteger();
+        DesktopNotificationService service = new DesktopNotificationService(enabled(), notice -> {
+            popups.incrementAndGet();
+            return ClientNotificationPublisher.Delivery.DELIVERED;
+        }, gateway, 250);
+        try {
+            service.notifyBlockedUsb(USER, device("block"));
+            service.onUsbAllowed(device("allow"));
+            Thread.sleep(400);
+            assertEquals(0, popups.get());
+        } finally {
+            service.stop();
+        }
+    }
+
+    @Test
+    void missingDeviceAtVerificationSuppressesStalePopup() throws Exception {
+        UsbGuardGateway gateway = mock(UsbGuardGateway.class);
+        when(gateway.listDevices()).thenReturn(List.of());
+        AtomicInteger popups = new AtomicInteger();
+        DesktopNotificationService service = new DesktopNotificationService(enabled(), notice -> {
+            popups.incrementAndGet();
+            return ClientNotificationPublisher.Delivery.DELIVERED;
+        }, gateway, 50);
+        try {
+            service.notifyBlockedUsb(USER, device("block"));
+            Thread.sleep(250);
+            assertEquals(0, popups.get());
+        } finally {
+            service.stop();
+        }
+    }
+}
