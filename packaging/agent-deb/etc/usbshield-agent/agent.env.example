# Example for /etc/usbshield-agent/agent.env; copy as root, chmod 0600, replace values.
# Never commit real credentials. DNS name must match the TLS certificate's SAN.
USBSHIELD_SERVER_URL=https://usbshield.example.internal
USBSHIELD_ENROLLMENT_TOKEN=REPLACE_WITH_DEPLOYMENT_SECRET
# For an internal CA; omit if the HTTPS certificate is trusted by the JVM.
USBSHIELD_TLS_CA_CERTIFICATE=/etc/usbshield-agent/usbshield-ca.pem
