#!/bin/bash
set -e

# 1. Create dedicated system user/group if not exists
if ! getent group usbshield >/dev/null; then
    groupadd --system usbshield
fi

if ! getent passwd usbshield >/dev/null; then
    useradd --system --gid usbshield --home-dir /var/lib/usbshield-agent --no-create-home \
            --shell /usr/sbin/nologin usbshield
fi

# 2. Setup directories and permissions
mkdir -p /opt/usbshield-agent
mkdir -p /etc/usbshield-agent
mkdir -p /var/lib/usbshield-agent/spool

chown -R root:usbshield /opt/usbshield-agent
chmod 755 /opt/usbshield-agent

chown -R root:usbshield /etc/usbshield-agent
chmod 750 /etc/usbshield-agent

chown -R usbshield:usbshield /var/lib/usbshield-agent
chmod 700 /var/lib/usbshield-agent

# 3. Add usbshield user to usbguard group for IPC access if applicable
if getent group usbguard >/dev/null; then
    usermod -aG usbguard usbshield
fi

# 4. Setup runtime notifier socket directory and tmpfiles.d (Week 2 Unix Socket IPC)
mkdir -p /run/usbshield-notifier
chmod 1777 /run/usbshield-notifier

if [ -d /etc/tmpfiles.d ]; then
    echo "d /run/usbshield-notifier 1777 root root -" > /etc/tmpfiles.d/usbshield-notifier.conf
fi

# Clean up deprecated sudoers rule from Week 1 prototype if present
if [ -f /etc/sudoers.d/usbshield ]; then
    rm -f /etc/sudoers.d/usbshield
fi

# Ensure launcher script executable if installed
if [ -f /opt/usbshield-agent/usbshield-notifier-launcher.sh ]; then
    chmod 755 /opt/usbshield-agent/usbshield-notifier-launcher.sh
fi

# 5. Verify or configure USBGuard fail-closed state
USBGUARD_CONF="/etc/usbguard/usbguard-daemon.conf"
if [ -f "$USBGUARD_CONF" ]; then
    if grep -q "^ImplicitPolicyTarget=allow" "$USBGUARD_CONF"; then
        echo "WARNING: USBGuard daemon configured with ImplicitPolicyTarget=allow (fail-open). Overriding to fail-closed (block)..."
        sed -i 's/^ImplicitPolicyTarget=allow/ImplicitPolicyTarget=block/' "$USBGUARD_CONF"
    elif ! grep -q "^ImplicitPolicyTarget=" "$USBGUARD_CONF"; then
        echo "ImplicitPolicyTarget=block" >> "$USBGUARD_CONF"
    fi
fi

# Initialize default USBGuard rules if not present or empty
if [ ! -s /etc/usbguard/rules.conf ] && [ -f /etc/usbshield-agent/rules-v0.1.conf ]; then
    mkdir -p /etc/usbguard
    cp /etc/usbshield-agent/rules-v0.1.conf /etc/usbguard/rules.conf
    chmod 600 /etc/usbguard/rules.conf
    echo "Initialized default fail-closed USBGuard rules at /etc/usbguard/rules.conf"
fi

# 6. Reload systemd daemon and manage service lifecycle
systemctl daemon-reload
if systemctl is-enabled usbguard.service >/dev/null 2>&1 || systemctl enable usbguard.service; then
    systemctl start usbguard.service || echo "WARNING: Could not start usbguard.service immediately."
fi

systemctl enable usbshield-agent.service
if systemctl restart usbshield-agent.service; then
    echo "USBShield Agent installed and started successfully."
else
    echo "WARNING: usbshield-agent.service was enabled but failed to restart immediately. Check systemctl status."
fi

exit 0
