# Replace every @@...@@ placeholder. Use a non-loopback static IPv4 for CENTRAL_LAN_IPV4.
# The certificate must cover IP:127.0.0.1 and the LAN DNS name. Keep backend on 127.0.0.1:18080.
# Use explicit bind so loopback and LAN stay separate. Do not add a wildcard listener.
server {
    listen 127.0.0.1:443 ssl bind;
    server_name 127.0.0.1;
    ssl_certificate @@FULLCHAIN_PEM_PATH@@;
    ssl_certificate_key @@PRIVATE_KEY_PEM_PATH@@;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 1m;

    location ^~ /api/auth/ {
        proxy_pass http://127.0.0.1:18080/api/auth/;
        proxy_set_header Host $host;
    }

    location ^~ /api/admin/ {
        proxy_pass http://127.0.0.1:18080/api/admin/;
        proxy_set_header Host $host;
    }

    location / { return 404; }
}

server {
    listen @@CENTRAL_LAN_IPV4@@:443 ssl bind;
    server_name @@USBSHIELD_DNS_NAME@@;
    ssl_certificate @@FULLCHAIN_PEM_PATH@@;
    ssl_certificate_key @@PRIVATE_KEY_PEM_PATH@@;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 1m;

    # Forward the normalized Agent URI with its own prefix. Admin is loopback-only.
    location ^~ /api/agent/ {
        allow @@CLIENT_CIDR@@;
        deny all;
        proxy_pass http://127.0.0.1:18080/api/agent/;
        proxy_set_header Host $host;
    }

    location / { return 403; }
}
