# Copy this file to .env in repository root, then enter the test role password.
# .env is ignored by Git. Use the SAME usbshield_test role for both test DBs.
# Do not put the application database credentials in this test-only .env.
USBSHIELD_TEST_DB_HOST=127.0.0.1
USBSHIELD_TEST_DB_PORT=5432
USBSHIELD_TEST_DB_USERNAME=usbshield_test
USBSHIELD_TEST_DB_PASSWORD=REPLACE_WITH_YOUR_TEST_PASSWORD
